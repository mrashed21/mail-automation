{
  "name": "gmail-recruitment-sender",
  "version": "1.0.0",
  "description": "Local Gmail recruitment email sender - sends professional candidate emails one by one with retry, logging, statistics and exports.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "retry": "ts-node src/index.ts --retry-failed",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "gmail",
    "nodemailer",
    "recruitment",
    "email",
    "typescript"
  ],
  "author": "Admin & HR Department",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
